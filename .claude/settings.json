{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue close:*)",
      "Bash(gh label:*)",
      "Bash(./scripts/issue-log.sh:*)",
      "Bash(./scripts/setup-labels.sh:*)",
      "Bash(./scripts/plan-to-issues.sh:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh issue close:*)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-close.sh"
          }
        ]
      }
    ]
  }
}
